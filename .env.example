# Copy this file to .env and fill in your values.
# python-dotenv is used by Streamlit automatically — values set here are
# picked up when you run:  streamlit run app.py

# ── Backend mode ───────────────────────────────────────────────────────────────
# Set to 1 to force the mock backend (instant demo, no file I/O, no API calls).
# Remove or set to 0 to use the real backend.
INCIDENT_REPLAY_MOCK=0

# ── Groq API key (optional) ────────────────────────────────────────────────────
# When set, the synthesis stage sends the collected evidence to an LLM on Groq
# to produce a more natural root_cause sentence.
# Leave blank (or remove the line) to keep the fully deterministic pipeline.
#
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Groq model (optional) ──────────────────────────────────────────────────────
# Default: qwen/qwen3.8-27b  (confirmed working on this account)
# Other available models on this key:
#   openai/gpt-oss-120b        (returns empty — not usable for text)
#   openai/gpt-oss-20b         (returns empty — not usable for text)
#   allam-2-7b                 (Arabic-focused)
# GROQ_MODEL=qwen/qwen3.8-27b
