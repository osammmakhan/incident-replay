# Copy this file to .env and fill in your values

# ── Backend mode ──────────────────────────────────────────────────────────────
# Set to 1 to force the mock backend regardless of whether the real backend
# is importable. Useful for demos and UI development.
INCIDENT_REPLAY_MOCK=1

# ── LLM / API keys (used by the real backend) ─────────────────────────────────
# OPENAI_API_KEY=sk-...
